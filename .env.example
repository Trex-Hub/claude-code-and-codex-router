# --- database (dbmate + app) ---
# On-prem single node. Point at a mounted volume in production (/data).
DATABASE_URL=sqlite:./data/relay.db

# --- dashboard admin ---
# Single shared password. Login sets a signed cookie.
RELAY_ADMIN_PASSWORD=change-me
# Secret used to sign the admin session cookie. Random string.
RELAY_SESSION_SECRET=change-me-too

# --- upstream ---
ANTHROPIC_API_BASE=https://api.anthropic.com

# --- signing / version ---
# Billing-header Claude Code version pin (vendored). Blank => bundled default.
RELAY_CLAUDE_CODE_VERSION=
# Enables shaping debug logs when set (e.g. "all" or "tool-use").
RELAY_DEBUG=

# --- server ---
PORT=3000
